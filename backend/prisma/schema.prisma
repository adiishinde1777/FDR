datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  passwordHash     String
  fullName         String
  role             String                 // SUPER_ADMIN, INSTITUTION_ADMIN, INSTITUTION_STAFF, VERIFICATION_OFFICER, APPROVING_AUTHORITY, AUDITOR
  phone            String?
  isActive         Boolean                @default(true)
  lastLoginAt      DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  memberships      InstitutionMembership[]
  assignedVerifications VerificationCase[] @relation("AssignedOfficer")
  approvalDecisions ApprovalDecision[]
  notifications    Notification[]
  auditEvents      AuditEvent[]
}

model Institution {
  id                 String                 @id @default(uuid())
  officialIdentifier String                 @unique // e.g. AICTE-1-10293847
  name               String
  address            String
  state              String
  district           String
  pinCode            String
  contactEmail       String
  contactPhone       String
  approvalReference  String
  accountStatus      String                 @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, SUSPENDED, REJECTED
  registrationDate   DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  memberships        InstitutionMembership[]
  securityDeposits   SecurityDeposit[]
  fdrs               FDRRecord[]
  documents          Document[]
  releaseRequests    ReleaseRefundRequest[]
}

model InstitutionMembership {
  id            String      @id @default(uuid())
  userId        String
  institutionId String
  roleInInst    String      @default("ADMIN") // ADMIN, STAFF
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
}

model SecurityDeposit {
  id               String                 @id @default(uuid())
  institutionId    String
  depositReference String                 @unique // e.g. SD-AICTE-2024-ENG-001
  programCategory  String                 // Engineering, Management, Pharmacy, MCA, Architecture
  requiredAmount   Float
  currency         String                 @default("INR")
  status           String                 @default("ACTIVE") // ACTIVE, RELEASED, FORFEITED, DEFICIENT
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  institution      Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fdrs             FDRRecord[]
  releaseRequests  ReleaseRefundRequest[]
}

model FDRRecord {
  id                   String                 @id @default(uuid())
  institutionId        String
  securityDepositId    String?
  fdrNumber            String
  issuingBank          String
  bankBranch           String
  ifscCode             String?
  depositAmount        Float
  currency             String                 @default("INR")
  issueDate            DateTime
  maturityDate         DateTime
  validityDate         DateTime?
  jointName            String?                // e.g. "Regional Officer, AICTE & Principal"
  accountStatus        String                 @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VERIFIED, DISCREPANT, APPROVED, REJECTED, RETURNED_FOR_CORRECTION, MATURED, RENEWED, RELEASED
  verificationStatus   String                 @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING_VERIFICATION, UNDER_REVIEW, ADDITIONAL_INFO_REQUIRED, DISCREPANCY_FOUND, VERIFICATION_RECORDED, VERIFICATION_FAILED, READY_FOR_APPROVAL
  autoRenewal          Boolean                @default(false)
  notes                String?
  isPotentialDuplicate Boolean                @default(false)
  duplicateNotes       String?
  createdById          String
  updatedById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  institution          Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  securityDeposit      SecurityDeposit?       @relation(fields: [securityDepositId], references: [id], onDelete: SetNull)
  documents            Document[]
  verificationCases    VerificationCase[]
  approvalCases        ApprovalCase[]
  ocrResults           OCRResult[]
  releaseRequests      ReleaseRefundRequest[]
  oldInRenewals        RenewalRequest[]       @relation("OldFDR")
  newInRenewals        RenewalRequest[]       @relation("NewFDR")

  @@index([fdrNumber])
  @@index([institutionId])
  @@index([accountStatus])
}

model Document {
  id                 String       @id @default(uuid())
  institutionId      String
  fdrId              String?
  documentType       String       // FDR_RECEIPT, BANK_CONFIRMATION_LETTER, BOARD_RESOLUTION, AUDIT_STATEMENT, RELEASE_REQUEST_DOC, OTHER
  originalFilename   String
  storagePath        String
  mimeType           String
  fileSize           Int
  checksumSha256     String
  uploadedById       String
  version            Int          @default(1)
  isArchived         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  institution        Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fdr                FDRRecord?   @relation(fields: [fdrId], references: [id], onDelete: SetNull)
  ocrResult          OCRResult?
}

model OCRResult {
  id                   String     @id @default(uuid())
  documentId           String     @unique
  fdrId                String
  extractedFdrNumber   String?
  extractedBankName    String?
  extractedAmount      Float?
  extractedIssueDate   DateTime?
  extractedMaturityDate DateTime?
  rawText              String?
  status               String     @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, NEEDS_MANUAL_REVIEW
  confidenceScore      Float?
  mismatchFlags        String?    // JSON string of mismatch details
  reviewerConfirmed    Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  document             Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fdr                  FDRRecord  @relation(fields: [fdrId], references: [id], onDelete: Cascade)
}

model VerificationCase {
  id                            String                    @id @default(uuid())
  fdrId                         String
  assignedOfficerId             String?
  status                        String                    @default("PENDING") // PENDING, IN_PROGRESS, ADDITIONAL_INFO_REQUESTED, COMPLETED, REJECTED
  externalVerificationType      String                    @default("NOT_APPLICABLE") // MANUAL_DOCUMENT_CHECK, BANK_LETTER_VERIFIED, BANK_API_CONFIRMED, NOT_APPLICABLE
  externalVerificationReference String?
  externalVerificationNotes     String?
  outcome                       String                    @default("PENDING") // RECOMMENDED_APPROVAL, RECOMMENDED_REJECTION, DISCREPANCY_DETECTED, PENDING
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  fdr                           FDRRecord                 @relation(fields: [fdrId], references: [id], onDelete: Cascade)
  assignedOfficer               User?                     @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  observations                  VerificationObservation[]
}

model VerificationObservation {
  id               String           @id @default(uuid())
  caseId           String
  officerId        String
  observationType  String           // DATA_MISMATCH, DOCUMENT_ILLEGIBLE, BANK_BRANCH_DISCREPANCY, AMOUNT_MISMATCH, DATE_ERROR, GENERAL_NOTE
  fieldName        String?
  enteredValue     String?
  observedValue    String?
  remarks          String
  isResolved       Boolean          @default(false)
  createdAt        DateTime         @default(now())

  verificationCase VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ApprovalCase {
  id                 String             @id @default(uuid())
  fdrId              String
  stage              String             @default("STAGE_1_SCRUTINY") // STAGE_1_SCRUTINY, STAGE_2_FINANCIAL_APPROVER, FINAL_EXECUTIVE
  status             String             @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED
  currentApproverRole String            @default("APPROVING_AUTHORITY")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  fdr                FDRRecord          @relation(fields: [fdrId], references: [id], onDelete: Cascade)
  decisions          ApprovalDecision[]
}

model ApprovalDecision {
  id             String        @id @default(uuid())
  caseId         String
  approverId     String
  decision       String        // APPROVED, REJECTED, RETURNED_FOR_CORRECTION
  previousStatus String
  newStatus      String
  remarks        String
  reason         String?
  createdAt      DateTime      @default(now())

  approvalCase   ApprovalCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approver       User          @relation(fields: [approverId], references: [id], onDelete: Cascade)
}

model RenewalRequest {
  id              String      @id @default(uuid())
  oldFdrId        String
  newFdrId        String?
  institutionId   String
  reason          String
  status          String      @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  submissionDate  DateTime    @default(now())
  reviewerRemarks String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  oldFdr          FDRRecord   @relation("OldFDR", fields: [oldFdrId], references: [id], onDelete: Cascade)
  newFdr          FDRRecord?  @relation("NewFDR", fields: [newFdrId], references: [id], onDelete: SetNull)
}

model ReleaseRefundRequest {
  id                          String          @id @default(uuid())
  requestNumber               String          @unique // e.g. REL-AICTE-2026-0012
  institutionId               String
  securityDepositId           String
  fdrId                       String
  requestType                 String          // FULL_RELEASE, PARTIAL_RELEASE, SURRENDER, REFUND
  requestDate                 DateTime        @default(now())
  requestedAmount             Float
  reason                      String
  conditionChecklist          String          // JSON array of checked conditions
  status                      String          @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, ADDITIONAL_INFO_REQUIRED, APPROVED, REJECTED, PROCESSING, SETTLED_EXTERNAL, CLOSED
  externalSettlementReference String?         // Bank UTR or Order number
  decisionRemarks             String?
  decidedById                 String?
  closedAt                    DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  institution                 Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  securityDeposit             SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)
  fdr                         FDRRecord       @relation(fields: [fdrId], references: [id], onDelete: Cascade)
}

model Notification {
  id                  String   @id @default(uuid())
  userId              String
  title               String
  message             String
  type                String   // FDR_SUBMITTED, VERIFICATION_ASSIGNED, INFO_REQUESTED, DISCREPANCY_FLAGGED, APPROVAL_UPDATE, MATURITY_REMINDER, RENEWAL_DUE, RELEASE_UPDATE, ESCALATION
  priority            String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  relatedResourceId   String?
  relatedResourceType String?
  isRead              Boolean  @default(false)
  emailSent           Boolean  @default(false)
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?
  actorEmail    String?
  actorRole     String?
  action        String   // e.g. FDR_CREATE, FDR_UPDATE, VERIFICATION_DECISION, APPROVAL_DECISION, DOCUMENT_UPLOAD, AUTH_LOGIN
  resourceType  String   // FDR, INSTITUTION, USER, DOCUMENT, APPROVAL, AUTH, RELEASE
  resourceId    String?
  details       String?  // JSON string
  ipAddress     String?
  correlationId String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model MaturityScheduleJob {
  id                String    @id @default(uuid())
  jobType           String    // e.g. MATURITY_ALERT
  targetDate        DateTime
  fdrId             String
  status            String    @default("PENDING") // PENDING, EXECUTED, FAILED
  reminderSentDays  Int
  executedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([fdrId, reminderSentDays])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
