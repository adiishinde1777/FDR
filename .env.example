# AICTE Security Deposit / FDR Management Portal - Environment Configuration

# Server
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
APP_URL=https://fdr.aicte-india.org

# Database
# PostgreSQL Production URL:
DATABASE_URL="postgresql://aicte_user:secure_password@postgres:5432/aicte_fdr_db?schema=public"
# Local Development (SQLite):
# DATABASE_URL="file:./dev.db"

# Session Security
SESSION_SECRET="replace_with_64_character_hex_random_secret_in_production"
CSRF_SECRET="replace_with_32_character_hex_random_secret_in_production"
COOKIE_DOMAIN=".aicte-india.org"

# File Storage
UPLOAD_STORAGE_DIR="/var/aicte/storage/documents"
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"

# Scheduler
SCHEDULER_ENABLED=true
TIMEZONE="Asia/Kolkata"
MATURITY_REMINDER_DAYS="30,15,7,0"

# Integrations (Documented interface boundaries)
BANK_VERIFICATION_API_ENABLED=false
BANK_VERIFICATION_API_URL="https://authorized-bank-api.gov.in"
BANK_VERIFICATION_API_KEY=""

AICTE_PORTAL_API_ENABLED=false
AICTE_PORTAL_API_URL="https://facilities.aicte-india.org/api/v1"
AICTE_PORTAL_API_KEY=""

SMTP_ENABLED=false
SMTP_HOST="smtp.gov.in"
SMTP_PORT=587
SMTP_USER="fdr-notifications@aicte-india.org"
SMTP_PASS=""
SMTP_FROM="AICTE FDR Portal <fdr-notifications@aicte-india.org>"
